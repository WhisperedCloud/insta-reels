# Copy this file to .env, fill in the values, then run:  python3 reels/setup_secrets.py
# .env stays on your computer only. Never paste these values into a chat.

GEMINI_API_KEY=
PIXABAY_API_KEY=

# From your Meta developer app (developers.facebook.com)
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=

# Instagram usernames, without @
QUIZ_HANDLE=
STOIC_HANDLE=
